{
  "configurations": [
    {
      "name": "release",
      "args": [
        "-G",
        "Unix Makefiles",
        "-DCMAKE_BUILD_TYPE=Release"
      ]
    },
    {
      "name": "extra",
      "args": [
        "-G",
        "Unix Makefiles",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DFIX_EXTRA=ON"
      ]
    }
  ],
  "dialect": "dsp-plugin",
  "roles": [
    {
      "match": "web/**",
      "role": "gui"
    }
  ]
}
