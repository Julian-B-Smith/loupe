#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# (This is the template a new or retrofitted project copies as its ./verify.
# It carries NO gate code: until 2.4.0 it shipped an inline `leak_gate`, and
# every repo born from it got a private copy that then drifted — ten variants,
# nine missing the Windows pattern. The gate now lives in kit/vendor/kit-gates.sh,
# which is canonical, vendored into .kit/, and pinned by sha256.)
#
# THIS FILE IS PROJECT-OWNED: edit `fast` and `full` freely, add project gates,
# wire your test commands. The kit-owned gates live in `.kit/kit-gates.sh`,
# which is vendored and checksummed — do not edit that one, and do not copy its
# contents here. Update it with:  python3 <kit>/kit_sync.py .
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  local ok=0
  kit_integrity || ok=1      # kit-owned files must match .kit/MANIFEST
  leak_gate     || ok=1      # privacy gate: kit-core, keep it first
  # Mutation tests: each case plants one known-bad snapshot and asserts the
  # checker refuses it — proves loupe-check FIRES, not merely that it exists.
  node tools/loupe-check.test.mjs || ok=1
  # History rules of the viewer (ADR 0024): one stack, a drag is one step, two pointers never freeze it.
  node tools/history.test.mjs || ok=1
  # Focus lenses (ADR 0019): deterministic membership from entry points, crawler edges only; layout in every mode.
  node tools/lens.test.mjs || ok=1
  # Headless render (Q-017): the design view renders and the conservation meter balances at every level of detail.
  node tools/render.test.mjs || ok=1
  # 'How it works' stories (ADR 0025): files exist in the graph, unsupported links state a reason, edits never
  # invent links, accounting partitions.
  node tools/story.test.mjs || ok=1
  # Crawler build layer (Q-012): runs `cmake` configure on fixtures/cmake-basic (never a build), compares the
  # facts with the golden, and proves the scratch directory is deleted, also when configure fails. Needs cmake.
  node crawler/build.test.ts || ok=1
  # Crawler syntax layer (Q-013): grammars match their pinned sha256 (a swapped .wasm fails here and refuses to load),
  # includes on the fixture equal the golden, conditions kept verbatim, resolution per site.
  node crawler/syntax.test.ts || ok=1
  # graph.json emission and build-target conformance (Q-016): the fixture's graph and findings equal their goldens,
  # loupe-check passes on the emitted snapshot with schema validation, every layer fact lands in the graph.
  node crawler/graph.test.ts || ok=1
  # The committed HORDE gate report (Q-025): it describes the committed graph, partitions every probe edge, loses
  # none, and every hand-written parity explanation is still used. The gate itself needs HORDE: see full.
  node tools/gate.test.mjs || ok=1
  # loupe-check on every example snapshot, with schema validation REQUIRED.
  # The checker silently skips JSON Schema when ajv is missing and still says
  # OK; that is a declared-not-effective gate, so the skip note is fatal here.
  local d out
  for d in schema/examples/*/; do
    out="$(node tools/loupe-check.mjs "$d" 2>&1)"; local rc=$?
    printf '%s\n' "$out" | tail -1 | sed "s|^|loupe-check ${d}: |"
    [ $rc -eq 0 ] || { printf '%s\n' "$out" >&2; ok=1; }
    if printf '%s' "$out" | grep -q 'schema validation skipped'; then
      echo "verify[fast]: ajv missing — run npm ci; schema validation cannot be skipped" >&2; ok=1
    fi
  done
  # horde-sample is GENERATED from prototype/data/sample-horde.js. Regenerate
  # into a temp dir and byte-compare, so an edit to the sample (or to canon.mjs)
  # without a re-run is caught instead of shipping a stale example (Q-002).
  local fresh; fresh="$(mktemp -d)"
  if node tools/convert-sample.mjs "$fresh" >/dev/null \
     && diff -r "$fresh" schema/examples/horde-sample >/dev/null; then
    echo "horde-sample: fresh (matches convert-sample.mjs output)"
  else
    echo "verify[fast]: schema/examples/horde-sample is stale — run: node tools/convert-sample.mjs" >&2
    diff -r "$fresh" schema/examples/horde-sample 2>&1 | head -20 >&2
    ok=1
  fi
  rm -r "$fresh"
  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # The P1a gates on HORDE (Q-025; Julian, 2026-10-18): clone the snapshot's commit on HORDE's terms, crawl twice,
  # leak-check, probe parity, zero unknown missing nodes; then the fresh crawl must equal the committed snapshot byte
  # for byte. Needs a local HORDE checkout (LOUPE_HORDE, ~/-relative default); without one the gate is SKIPPED and
  # full exits 3, recorded as such, never as a pass (Julian, 2026-10-18). A failing gate is named, with the reason
  # from tools/horde-gate-waiting.json when it waits on something outside Loupe; it stays red either way, but exits 4
  # when every failure is such a gate with exactly its listed ids and every byte-compare held, 1 for anything else,
  # so "only waiting" is decided by code, never by reading this text.
  # Planned (P2): stress-case renders with the meter balanced.
  local ok=0 waiting=0 horde="${LOUPE_HORDE:-$HOME/Documents/Claude/synthetic-worlds/horde}" snap=design/prototype/snapshots/horde-crawl
  if [ -e "$horde/.git" ]; then  # -e: a worktree's .git is a file
    local commit out; commit="$(node -e "process.stdout.write(JSON.parse(require('fs').readFileSync('$snap/graph.json','utf8')).source.commit)")"
    out="$(mktemp -d)"
    if ! node tools/horde-gate.mjs --horde "$horde" --commit "$commit" --dialect dsp-plugin --out "$out"; then
      # exit 4 from this check: every failing gate waits, with exactly its listed ids; 1: anything else
      node -e "
        const fs = require('fs'), g = JSON.parse(fs.readFileSync('$out/gate.json', 'utf8')), w = JSON.parse(fs.readFileSync('tools/horde-gate-waiting.json', 'utf8')).waiting;
        const same = (a, b) => JSON.stringify([...(a || [])].sort()) === JSON.stringify([...(b || [])].sort());
        let all = true;
        for (const [k, v] of Object.entries(g.gates)) if (!v.pass) {
          const ok = w[k] && same(w[k].ids, v.ids); all = all && !!ok;
          console.error('verify[full]: HORDE gate ' + k + ' fails' + (ok ? ': ' + w[k].reason : ' (not a listed wait: a regression)'));
        }
        process.exit(all ? 4 : 1);
      "; case $? in 4) waiting=1 ;; *) ok=1; [ -s "$out/gate.json" ] || echo "verify[full]: the HORDE gate wrote no report (a crawl, probe or leak failure above)" >&2 ;; esac
    fi
    local f; for f in graph.json conformance.json overlay.json view.json parity.json gate.json; do
      cmp -s "$out/$f" "$snap/$f" || { echo "verify[full]: $snap/$f differs from a fresh gate run (regenerate it with tools/horde-gate.mjs and review the diff)" >&2; ok=1; }
    done
    rm -r "$out"
  else
    echo "verify[full]: SKIPPED the HORDE gates: no checkout at LOUPE_HORDE ($horde). Not a pass: exit 3." >&2
    return 3
  fi
  [ $ok -eq 0 ] && [ $waiting -eq 1 ] && { echo "verify[full]: red only on listed waits (exit 4); see ROADMAP Q-025" >&2; return 4; }
  return $ok
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
