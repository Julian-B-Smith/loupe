                      "configs": false
                    }
                  }
                },
                "edges": {
                  "items": {
                    "properties": {
                      "kind": {
                        "not": {
                          "enum": [
                            "builds",
                            "depends"
                          ]
                        }
                      },
                      "configs": false,
                      "evidence": {
                        "items": {
                          "properties": {
                            "resolution": {
                              "not": {
                                "enum": [
                                  "build",
                                  "syntactic"
                                ]
                              }
                            },
                            "via": false,
                            "configs": false,
                            "as": false
                          }
