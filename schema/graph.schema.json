{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loupe.dev/schema/graph-0.4.json",
  "title": "Loupe graph",
  "description": "Either a crawl (0.2 to 0.3.2: deterministic crawler output) or, from 0.4, a declaration (a structure a target repo states about itself, read by one deterministic adapter). A graph is one or the other, never both. Same inputs give byte-identical canonical JSON. Agents and humans never write this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema": {
      "enum": [
        "loupe.graph/0.2",
        "loupe.graph/0.3",
        "loupe.graph/0.3.1",
        "loupe.graph/0.3.2",
        "loupe.graph/0.4"
      ],
      "description": "0.3 adds build targets, configurations (ADR 0026) and required resolution on crawl evidence (ADR 0028); a 0.2 graph stays valid as 0.2. 0.3.1 adds `via` (the compiled sources whose include path found the file) and `configs` on site evidence. 0.3.2 adds `as` on generates evidence: program (what the command runs) or input (what it reads). 0.4 adds the declaration graph: block and slot nodes, audio/control/event/modulation/observation edges, provenance declared, a citation on every node and edge, and a `declaration` block in place of `crawler`. The `declaration` block, not the version, decides crawl against declaration; a declaration graph must declare 0.4."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "commit",
        "commitTime",
        "dirty"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "description": "e.g. github.com/Julian-B-Smith/horde"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$|^sample$"
        },
        "commitTime": {
          "type": "string",
          "description": "Commit timestamp (ISO 8601). Never wall-clock time."
        },
        "dirty": {
          "type": "boolean",
          "description": "True if the working tree had uncommitted changes. Dirty graphs are never archived."
        }
      }
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "granularity",
        "languages",
        "dialect",
        "scope",
        "inventory"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "granularity": {
          "enum": [
            "file",
            "symbol"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "dialect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Rule set that assigns semantic roles deterministically, e.g. dsp-plugin"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "include",
            "exclude",
            "resolution"
          ],
          "description": "What the crawl looked at and how it resolved references. Recorded so nothing is left out silently.",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Globs or extensions crawled"
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Globs or extensions deliberately left out"
            },
            "resolution": {
              "enum": [
                "compile-db",
                "heuristic",
                "build"
              ],
              "description": "compile-db = include paths and defines from compile_commands.json; heuristic = path search; build = from the build system itself (CMake File API, ADR 0027)"
            },
            "target": {
              "type": "string",
              "description": "Build target or platform configuration the crawl assumed, e.g. macos-arm64-release"
            },
            "defines": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Preprocessor defines assumed when evaluating guards"
            },
            "siblings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Path prefixes that belong to sibling repos, e.g. foundations/"
            }
          }
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files",
            "crawled",
            "excluded"
          ],
          "description": "Every file in the repo is either crawled or counted here as excluded. files = crawled + sum(excluded.count).",
          "properties": {
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "crawled": {
              "type": "integer",
              "minimum": 0
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reason",
                  "count"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "e.g. docs, traces, binary, lockfile"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "byExt": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "description": "0.3: the build configurations this graph covers (ADR 0026), from the target repo's .loupe/config.json. An edge with no `configs` holds in all of them.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "args"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "buildType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "generator": {
                "type": "string"
              }
            }
          }
        },
        "notEvaluated": {
          "type": "array",
          "description": "0.3: what the configurations could not evaluate on this host (another OS, an option not declared, files built outside the build system). Listed, never treated as absent. Required in 0.3; an empty list says everything was evaluated.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "what",
              "reason"
            ],
            "properties": {
              "what": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "nodes": {
      "type": "array"
    },
    "edges": {
      "type": "array"
    },
    "declaration": {
      "$ref": "#/definitions/declaration"
    }
  },
  "definitions": {
    "nodeId": {
      "type": "string",
      "pattern": "^(file|sym|ext|art|miss|target):.+$",
      "description": "file:<repo path> | sym:<path>#<qualified name> | ext:<package> | art:<path or glob> | miss:<referenced path> | target:<build target name> (0.3)"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "hash"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/nodeId"
        },
        "kind": {
          "enum": [
            "file",
            "symbol",
            "external",
            "artifact",
            "missing",
            "target"
          ]
        },
        "path": {
          "type": "string",
          "description": "Repo-relative path; for external, the package name"
        },
        "lang": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64}|none)$",
          "description": "Content hash; anchors explainers and drives diffs"
        },
        "loc": {
          "type": "integer",
          "minimum": 0
        },
        "parent": {
          "$ref": "#/definitions/nodeId",
          "description": "Symbols point at their file"
        },
        "symbolKind": {
          "enum": [
            "class",
            "struct",
            "function",
            "method",
            "variable",
            "type",
            "module"
          ]
        },
        "role": {
          "type": "string",
          "description": "What the file is for, from a deterministic rule: product, test, probe, bench, generator, scratch, gui, data, build, doc, vendored"
        },
        "roleRule": {
          "type": "string",
          "description": "Id of the rule that assigned the role"
        },
        "missing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason"
          ],
          "description": "Required when kind is missing: referenced by the code but not present in the tree",
          "properties": {
            "reason": {
              "enum": [
                "generated",
                "external",
                "sibling",
                "unknown"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "targetType": {
          "type": "string",
          "description": "0.3, kind target only: the build system's target type, e.g. STATIC_LIBRARY, EXECUTABLE, UTILITY"
        },
        "configs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "0.3, kind target only: the configurations in which the target exists (ADR 0026). Absent = all of them. Sorted, and never the full list (that is spelled by omission)."
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "dst",
        "kind",
        "provenance",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^e:[0-9a-f]{16}$",
          "description": "First 16 hex of sha256('src|dst|kind')"
        },
        "src": {
          "$ref": "#/definitions/nodeId"
        },
        "dst": {
          "$ref": "#/definitions/nodeId"
        },
        "kind": {
          "enum": [
            "include",
            "import",
            "call",
            "reference",
            "inherit",
            "instantiate",
            "test",
            "config",
            "data",
            "generates",
            "embeds",
            "builds",
            "depends"
          ],
          "description": "Syntactic kind. generates = a script or build rule produces the target file; embeds = a file is compiled into another (e.g. HTML into a header). builds (0.3) = a build target compiles or lists this file; depends (0.3) = a build target needs another target built first (linking, or ordering only: the build system does not say which)."
        },
        "role": {
          "type": "string",
          "description": "Semantic role from deterministic dialect rules (e.g. audio, param, mod). Agent-assigned roles live in the overlay."
        },
        "roleRule": {
          "type": "string",
          "description": "Id of the dialect rule that assigned the role"
        },
        "provenance": {
          "enum": [
            "static",
            "config"
          ],
          "description": "The crawler only produces static and config edges"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of distinct sites"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/crawlEvidence"
          }
        },
        "configs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "0.3: names of the crawler configurations in which this edge holds (ADR 0026). Absent = all of them. Sorted, and never the full list (that is spelled by omission)."
        }
      }
    },
    "crawlEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "line"
          ],
          "properties": {
            "type": {
              "const": "site"
            },
            "path": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "col": {
              "type": "integer",
              "minimum": 1
            },
            "signature": {
              "type": "string",
              "description": "Callee signature, e.g. render(AudioBlock&). Required for bus contract checks."
            },
            "guard": {
              "type": "string",
              "description": "Preprocessor condition the site sits under, e.g. defined(_WIN32)"
            },
            "resolution": {
              "enum": [
                "exact",
                "compile-db",
                "search",
                "build",
                "syntactic"
              ],
              "description": "How the target was found (ADR 0028). exact = path as written exists; compile-db = via compile_commands.json; search = heuristic path search, worth auditing; build = read from the build system; syntactic = matched by name in a parse tree, unresolved. Required in 0.3."
            },
            "via": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "0.3.1: the compiled sources whose compile's include path found this file (repo paths), when it was not found next to the including file or through its own compile. An auditor checks these compiles."
            },
            "configs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              },
              "description": "0.3.1: the configurations in which this directive holds, when narrower than all; the edge's configs is the union of its sites'."
            },
            "as": {
              "enum": [
                "program",
                "input"
              ],
              "description": "0.3.2, generates edges only: program = the source is what makes the output (the script a custom command runs, the target that owns the command, an executable target the command starts with, or code that writes the file); input = the command reads or waits for the source. Build-time code is the program side; an input is compiled into whatever consumes the output."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "key"
          ],
          "properties": {
            "type": {
              "const": "config"
            },
            "path": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "description": "Where in the config file, e.g. fx.chain[2]"
            },
            "guard": {
              "type": "string",
              "description": "Build-system condition the config entry sits under, e.g. HYPERSAW_GUI2 or NOT HYPERSAW_GUI2"
            },
            "resolution": {
              "enum": [
                "exact",
                "compile-db",
                "search",
                "build",
                "syntactic"
              ],
              "description": "How the target was found (ADR 0028). exact = path as written exists; compile-db = via compile_commands.json; search = heuristic path search, worth auditing; build = read from the build system; syntactic = matched by name in a parse tree, unresolved. Required in 0.3."
            },
            "as": {
              "enum": [
                "program",
                "input"
              ],
              "description": "0.3.2, generates edges only: program = the source is what makes the output (the script a custom command runs, the target that owns the command, an executable target the command starts with, or code that writes the file); input = the command reads or waits for the source. Build-time code is the program side; an input is compiled into whatever consumes the output."
            }
          }
        }
      ]
    },
    "crawlEvidence03": {
      "description": "0.3: crawl evidence must say how it was resolved (ADR 0028).",
      "allOf": [
        {
          "$ref": "#/definitions/crawlEvidence"
        },
        {
          "required": [
            "resolution"
          ]
        }
      ]
    },
    "edge03": {
      "description": "0.3 edge: evidence items carry resolution.",
      "allOf": [
        {
          "$ref": "#/definitions/edge"
        },
        {
          "properties": {
            "evidence": {
              "items": {
                "$ref": "#/definitions/crawlEvidence03"
              }
            }
          }
        }
      ]
    },
    "declNodeId": {
      "type": "string",
      "pattern": "^decl:.+$",
      "description": "0.4: decl:<declared id>. A declared item is not a file."
    },
    "declNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "declared"
      ],
      "description": "0.4 declaration graphs only: an item the target repo declares. No path and no hash: nothing here is a file.",
      "properties": {
        "id": {
          "$ref": "#/definitions/declNodeId"
        },
        "kind": {
          "enum": [
            "block",
            "slot"
          ],
          "description": "A slot is a reserved, unbuilt place."
        },
        "declared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "scope",
            "multiplicity",
            "parent",
            "cites"
          ],
          "description": "What the declaration says, in its own words. `scope` is the declaration's word (e.g. engine, external): namespaced here so it is never read as the crawl's node kind `external`.",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "The declaration's own id; the label the viewer shows"
            },
            "label": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "multiplicity": {
              "type": [
                "string",
                "null"
              ],
              "description": "How many instances, in the declaration's words; null when one"
            },
            "parent": {
              "type": [
                "string",
                "null"
              ],
              "description": "The declared id (not the Loupe id) of the block this one nests in; null at the top"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Spec ids this item rests on. loupe-check D5 requires at least one."
            }
          }
        }
      }
    },
    "declEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "dst",
        "kind",
        "provenance",
        "declared",
        "evidence"
      ],
      "description": "0.4 declaration graphs only. Id is sha256(src|dst|kind) as everywhere: a second declared edge with the same three merges its evidence.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^e:[0-9a-f]{16}$",
          "description": "First 16 hex of sha256('src|dst|kind')"
        },
        "src": {
          "$ref": "#/definitions/declNodeId"
        },
        "dst": {
          "$ref": "#/definitions/declNodeId"
        },
        "kind": {
          "enum": [
            "audio",
            "control",
            "event",
            "modulation",
            "observation"
          ],
          "description": "The declaration format's closed list, pinned by declaration.format"
        },
        "provenance": {
          "const": "declared",
          "description": "A fact the target states and gates, never Loupe's inference"
        },
        "declared": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "cites"
          ],
          "properties": {
            "label": {
              "type": "string",
              "description": "The declaration's words for the edge; empty when it gives none"
            },
            "cites": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Spec ids. loupe-check D5 requires at least one."
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "id"
            ],
            "properties": {
              "type": {
                "const": "declaration"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$",
                "description": "Repo-relative; loupe-check requires it to equal declaration.path"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The declaration's own id for this edge"
              }
            }
          }
        }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "path",
        "blob",
        "spec",
        "counts",
        "signalPath"
      ],
      "description": "0.4: where the declaration was read from, and what it says about itself. Required in a declaration graph; forbidden in a crawl.",
      "properties": {
        "format": {
          "enum": [
            "horde.engine-structure/1"
          ],
          "description": "The format and version the adapter read. One value today; it extends with each declaration format a Loupe adapter learns (a new format is a schema change, so it is pinned here rather than free text)."
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$",
          "description": "Repo-relative path of the declaration file"
        },
        "blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$",
          "description": "Git blob id of the declaration at source.commit"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "blob"
          ],
          "description": "The spec the declaration cites",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
            },
            "blob": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
            }
          }
        },
        "counts": {
          "type": "object",
          "description": "The declaration's own census of itself. loupe-check D6 compares it with what the graph holds.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            ]
          }
        },
        "signalPath": {
          "type": "array",
          "description": "The declared signal path, in declared order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "ids",
              "refs"
            ],
            "properties": {
              "stage": {
                "type": "string"
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "The declaration's own ids"
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(decl:.+|e:[0-9a-f]{16})$"
                },
                "description": "Loupe ids the ids resolve to, so loupe-check (D4) validates every stage"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "declaration"
        ]
      },
      "then": {
        "description": "A declaration graph (the `declaration` block is what makes it one, at any version; the version says only shape): it must declare 0.4, and `crawler` is forbidden.",
        "required": [
          "declaration"
        ],
        "properties": {
          "crawler": false,
          "nodes": {
            "items": {
              "$ref": "#/definitions/declNode"
            }
          },
          "edges": {
            "items": {
              "$ref": "#/definitions/declEdge"
            }
          },
          "schema": {
            "const": "loupe.graph/0.4"
          }
        }
      },
      "else": {
        "description": "A crawl (no `declaration`): `crawler` required, and the crawl node and edge shapes apply, under the rules of its declared version (0.4 shares the 0.3.2 shape).",
