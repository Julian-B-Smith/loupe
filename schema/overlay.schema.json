{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loupe.dev/schema/overlay-0.2.json",
  "title": "Loupe overlay",
  "description": "Everything added on top of the crawl by agents, runtime traces or humans. Merged with graph.json to form the working graph. Never edits or deletes a crawled edge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "graph",
    "edges",
    "roles",
    "conditions"
  ],
  "properties": {
    "schema": {
      "const": "loupe.overlay/0.2"
    },
    "graph": {
      "$ref": "#/definitions/graphRef"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/overlayEdge"
      }
    },
    "roles": {
      "type": "array",
      "description": "Semantic roles assigned to crawled edges by an agent or a human",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge",
          "role",
          "evidence"
        ],
        "properties": {
          "edge": {
            "type": "string",
            "pattern": "^e:[0-9a-f]{16}$"
          },
          "role": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/definitions/claimEvidence"
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "description": "Conditions under which an edge is live, e.g. only when ROAM is enabled",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge",
          "condition",
          "evidence"
        ],
        "properties": {
          "edge": {
            "type": "string",
            "pattern": "^e:[0-9a-f]{16}$"
          },
          "condition": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/definitions/claimEvidence"
          }
        }
      }
    }
  },
  "definitions": {
    "graphRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "overlayEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "src",
        "dst",
        "kind",
        "provenance",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^e:[0-9a-f]{16}$"
        },
        "src": {
          "type": "string",
          "pattern": "^(file|sym|ext|art|miss):.+$"
        },
        "dst": {
          "type": "string",
          "pattern": "^(file|sym|ext|art|miss):.+$"
        },
        "kind": {
          "enum": [
            "include",
            "import",
            "call",
            "reference",
            "inherit",
            "instantiate",
            "test",
            "config",
            "data",
            "generates",
            "embeds"
          ]
        },
        "role": {
          "type": "string"
        },
        "provenance": {
          "enum": [
            "runtime",
            "annotated",
            "inferred"
          ],
          "description": "Strongest evidence present, in the fixed order runtime > annotated > inferred"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/claimEvidence"
          }
        }
      }
    },
    "claimEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "trace",
            "observed"
          ],
          "properties": {
            "type": {
              "const": "trace"
            },
            "trace": {
              "type": "string",
              "description": "Trace file or id"
            },
            "observed": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "author",
            "note"
          ],
          "properties": {
            "type": {
              "const": "annotation"
            },
            "author": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "dialogue": {
              "type": "string",
              "description": "Id of the Stage 3 question this came from"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "agent",
            "rationale"
          ],
          "properties": {
            "type": {
              "const": "inference"
            },
            "agent": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
