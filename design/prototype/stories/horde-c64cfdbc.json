            }
          ]
        },
        {
          "id": "s9",
          "concept": "fx",
          "label": "FX rack through the routing matrix",
          "does": "Sources feed four effect slots through a crosspoint matrix (ADR-088). The default topology is a serial chain, bit-exact with the old hardcoded series.",
          "files": [
            "file:src/fx_rack.h",
            "file:src/routing_core.h",
