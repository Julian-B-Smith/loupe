          ]
        },
        {
          "id": "s7",
          "concept": "oscillators",
          "label": "Render the oscillators",
          "does": "Oscillator 0 renders straight into the output; the others render into their own source buffers. The engine is either the SAW swarm or SPECTRA; the sub oscillator follows the notes in both.",
          "files": [
            "file:src/swarm_core.h",
            "file:src/force_core.h",
            "file:src/spectra_core.h",
            "file:src/subosc_core.h"
