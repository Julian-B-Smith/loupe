    {
      "id": "story:note-on",
      "title": "A note arrives",
      "question": "What happens between a key going down and a voice sounding?",
      "by": "agent:structure",
      "steps": [
        {
          "id": "n1",
          "concept": "event",
          "label": "Note-on in the block's events",
          "does": "The host delivers the note inside a process() call; it is handled at its exact frame.",
          "files": [
            "file:src/hypersaw_clap.cpp",
            "ext:clap"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8200,
              "note": "case CLAP_EVENT_NOTE_ON"
            }
          ]
        },
        {
          "id": "n2",
          "concept": "velocity",
          "label": "Velocity 0 is a release",
          "does": "MIDI 1.0 sends releases as note-on with velocity 0 (ADR-038); those take the note-off path.",
          "files": [
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8211
            }
          ]
        },
        {
          "id": "n3",
          "concept": "pitch",
          "label": "Key to frequency",
          "does": "Twelve-tone equal temperament from A440.",
          "files": [
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8216
            }
          ]
        },
        {
          "id": "n4",
          "concept": "comb",
          "label": "Tell the FX rack's comb",
          "does": "The rack's per-note comb is retuned to the note, whichever engine plays it (ADR-071).",
          "files": [
            "file:src/fx_rack.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8219,
              "note": "rack.noteOn(n->key, freq)"
            }
          ]
        },
        {
          "id": "n5",
          "concept": "engine",
          "label": "SPECTRA, SAW poly or SAW mono?",
          "does": "SPECTRA is plain polyphony. SAW is polyphonic unless Voice Mode is mono, which goes through the held-key logic first.",
          "files": [
            "file:src/spectra_core.h",
            "file:src/swarm_core.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8220,
              "note": "if (spectraMode())"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8243,
              "note": "if (voiceMono != 0)"
            }
          ]
        },
        {
          "id": "n10",
          "concept": "spectra-voice",
          "label": "Start a SPECTRA voice",
          "does": "SPECTRA allocates a slot for the note (no mono or glide; those are SAW features, ADR-037).",
          "files": [
            "file:src/spectra_core.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8225,
              "note": "spectra.noteOn(n->key, freq)"
            }
          ]
        },
        {
          "id": "n6",
          "concept": "voice-mode",
          "label": "Mono: held keys, legato, glide",
          "does": "A held-key stack gives last-note priority. With another key still held and the voice gated, the voice retargets (glide or legato) instead of striking anew. Overflow drops the oldest key (ADR-126).",
          "files": [
            "file:src/hypersaw_clap.cpp",
            "file:src/glide_core.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8243,
              "note": "if (voiceMono != 0)"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8301,
              "note": "retargetAll(monoSlot, ...)"
            }
          ]
        },
        {
          "id": "n7",
          "concept": "voice",
          "label": "Start voices on every oscillator",
          "does": "The SAW core and each further oscillator start a voice at the note's frequency. Velocity scales each voice's gain (ADR-084) and is a modulation-matrix source.",
          "files": [
            "file:src/swarm_core.h",
            "file:src/force_core.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8342,
              "note": "core.noteOn(n->key, freq)"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8343,
              "note": "core.setNoteVelocity(slot, n->velocity)"
            },
            {
              "path": "src/swarm_core.h",
              "line": 1228,
              "note": "gain = ... * s.vel * s.pressSm"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8239,
              "note": "srcVel: matrix source 14"
            }
          ]
        },
        {
          "id": "n8",
          "concept": "sub",
          "label": "Sub oscillator follows",
          "does": "The sub is a routing source beside the engines, so it follows the note in SPECTRA and SAW alike (B172).",
          "files": [
            "file:src/subosc_core.h"
          ],
          "evidence": [
