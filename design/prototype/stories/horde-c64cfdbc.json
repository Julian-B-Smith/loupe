          ]
        },
        {
          "id": "s10",
          "concept": "master",
          "label": "Master volume",
          "does": "Last gain in the chain, smoothed over about 8 ms and snapped to exactly 1.0 at unity so old patches stay byte-identical.",
          "files": [
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
