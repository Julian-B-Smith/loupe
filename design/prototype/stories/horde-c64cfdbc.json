        },
        {
          "id": "s11",
          "concept": "visualizer",
          "label": "Feed the meters and scope",
          "does": "Peak meters and the spectrum read the master output after volume. The waveform scope taps each oscillator separately (ADR-100); the master scope feed is retired.",
          "files": [
            "file:src/hypersaw_clap.cpp",
            "file:src/gui/hypersaw_gui.mm"
