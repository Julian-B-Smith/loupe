            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8800,
              "note": "spectra.render in SPECTRA mode"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8595,
              "note": "renderSubSpan"
            }
          ]
        },
        {
          "id": "s8",
          "concept": "bass-mono",
          "label": "Bass mono (off by default)",
          "does": "When switched on, low frequencies are folded to mono, per source. Its position is pre (before FX, the default), post, or both (B146).",
          "files": [
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
            {
