      "id": "story:audio-block",
      "title": "One audio block",
      "question": "What happens each time the host asks the plugin for audio?",
      "by": "agent:structure",
      "steps": [
        {
          "id": "s1",
          "concept": "host",
          "label": "Host asks for a block",
          "does": "The DAW calls the CLAP process callback with the block's events, transport and output buffers.",
          "files": [
            "file:src/hypersaw_clap_entry.cpp",
            "file:src/hypersaw_clap.cpp",
            "ext:clap"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 9046,
              "note": "plug_process forwards to Plugin::process"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8715,
              "note": "process(const clap_process_t*)"
            }
          ]
        },
        {
          "id": "s2",
          "concept": "tempo",
          "label": "Read host tempo",
          "does": "The host's tempo becomes the grid tempo (ADR-022); with none, the last known tempo stays.",
          "files": [
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8720
            }
          ]
        },
        {
          "id": "s3",
          "concept": "gui-edits",
          "label": "Apply GUI edits",
          "does": "Edits queued by the editor are applied directly to the parameters and echoed to the host as parameter events. They do not pass through the event loop.",
          "files": [
            "file:src/hypersaw_clap.cpp",
            "file:src/gui/hypersaw_gui.mm",
            "file:src/gui/hypersaw_gui.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8722,
              "note": "drainQueue(p->out_events)"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 5520,
              "note": "applyParam(m.id, m.value)"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 5537,
              "note": "CLAP_EVENT_PARAM_VALUE pushed to the host"
            }
          ]
        },
        {
          "id": "s4",
          "concept": "events",
          "label": "Handle events at their exact frame",
          "does": "The block is split at each host event's timestamp, so notes and the host's parameter changes land on the right sample.",
          "files": [
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8763,
              "note": "handleEvent(ev) inside the per-frame loop"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8195,
              "note": "handleEvent: notes, parameter values"
            }
          ]
        },
        {
          "id": "s5",
          "concept": "morph",
          "label": "Step morph and modulation",
          "does": "When Morph is on, parameters drift between four corner presets. Modulation (LFOs, envelopes, the matrix) steps every span. Intent resolution exists behind a dev flag that ships off.",
          "files": [
            "file:src/morph_core.h",
            "file:src/mod_core.h",
            "file:src/intent_core.h"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8772,
              "note": "if (morphOn > 0.5) morphStep(...)"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8773,
              "note": "modStep(...), every span"
            },
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 4515,
              "note": "intentStep only when the dev flag intentBusOn is on"
            }
          ]
        },
        {
          "id": "s6",
          "concept": "bend-grid",
          "label": "Step the pitch-bend grid",
          "does": "When a bend law is engaged, the span is cut into grid steps and every note's tuning is updated on the grid clock.",
          "files": [
            "file:src/glide_core.h",
            "file:src/hypersaw_clap.cpp"
          ],
          "evidence": [
            {
              "path": "src/hypersaw_clap.cpp",
              "line": 8774,
              "note": "if (bendActive() && !spectraMode())"
